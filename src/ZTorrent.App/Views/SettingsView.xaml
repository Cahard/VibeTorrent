<UserControl x:Class="ZTorrent.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="900" xmlns:loc="clr-namespace:ZTorrent.App.Localization">
    <UserControl.Resources>
        <Style x:Key="SettingsSection" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderBrush" Value="{DynamicResource B_18FFFFFF}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Background" Value="{DynamicResource B_0E111D}" />
        </Style>
        <Style x:Key="SectionIcon" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource B_167C3AED}" />
            <Setter Property="BorderBrush" Value="{DynamicResource B_287C3AED}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,11,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="SettingLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingHint" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingRow" TargetType="{x:Type Border}">
            <Setter Property="BorderBrush" Value="{DynamicResource B_0CFFFFFF}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,12" />
        </Style>
        <Style x:Key="NumberBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource DarkTextBox}">
            <Setter Property="Width" Value="110" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{loc:T 'CONFIGURATION'}" Style="{StaticResource MicroCaption}"
                           Foreground="{DynamicResource VioletBrush}" Margin="0,0,0,4" />
                <TextBlock Text="{loc:T 'Settings'}" Style="{StaticResource DisplayTitle}" />
                <TextBlock Text="{loc:T 'Network, speed and storage - everything is under control.'}"
                           Style="{StaticResource Caption}" Margin="1,3,0,0" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch" Padding="0,0,10,0">
            <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">
                <Border Background="{DynamicResource B_1AFB7185}" BorderBrush="{DynamicResource B_44FB7185}" BorderThickness="1" CornerRadius="11"
                        Padding="12,9" Margin="0,0,0,14"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Top"
                                   Margin="0,1,8,0" />
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="11.5" Foreground="{DynamicResource B_FFE4E8}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- general -->
                <Border Style="{StaticResource SettingsSection}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <Border Style="{StaticResource SectionIcon}">
                                <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyph}" FontSize="15"
                                           Foreground="{DynamicResource B_D8B4FE}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:T 'General'}" Style="{StaticResource H3}" />
                                <TextBlock Text="{loc:T 'Application behavior and download folder'}" Style="{StaticResource SettingHint}"
                                           Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <Border Style="{StaticResource SettingRow}" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T 'Downloads folder'}" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{loc:T 'Where new torrents are saved'}" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                         Text="{Binding DownloadDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,8,0" Padding="10,7" />
                                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Padding="11,7"
                                        Command="{Binding BrowseDownloadFolderCommand}">
                                    <TextBlock Text="{loc:T 'Browse'}" FontSize="11" />
                                </Button>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T 'Appearance'}" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{loc:T 'Theme'}" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <RadioButton Style="{StaticResource LanguageChip}" GroupName="Theme"
                                                 Margin="0,0,6,0"
                                                 IsChecked="{Binding IsThemeDark, Mode=OneWay}"
                                                 Command="{Binding SetThemeCommand}" CommandParameter="dark">
                                        <TextBlock Text="{loc:T 'Dark'}" Style="{StaticResource ChipText}" />
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource LanguageChip}" GroupName="Theme"
                                                 Margin="0,0,6,0"
                                                 IsChecked="{Binding IsThemeGreen, Mode=OneWay}"
                                                 Command="{Binding SetThemeCommand}" CommandParameter="green">
                                        <TextBlock Text="{loc:T 'Green'}" Style="{StaticResource ChipText}" />
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource LanguageChip}" GroupName="Theme"
                                                 IsChecked="{Binding IsThemeLight, Mode=OneWay}"
                                                 Command="{Binding SetThemeCommand}" CommandParameter="light">
                                        <TextBlock Text="{loc:T 'Light'}" Style="{StaticResource ChipText}" />
                                    </RadioButton>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T 'Language'}" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{loc:T 'Interface language'}" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <RadioButton Style="{StaticResource LanguageChip}" GroupName="Language"
                                                 Margin="0,0,6,0"
                                                 IsChecked="{Binding IsEnglish, Mode=OneWay}"
                                                 Command="{Binding SetLanguageCommand}" CommandParameter="en">
                                        <TextBlock Text="English" Style="{StaticResource ChipText}" />
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource LanguageChip}" GroupName="Language"
                                                 Margin="0,0,6,0"
                                                 IsChecked="{Binding IsRussian, Mode=OneWay}"
                                                 Command="{Binding SetLanguageCommand}" CommandParameter="ru">
                                        <TextBlock Text="Русский" Style="{StaticResource ChipText}" />
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource LanguageChip}" GroupName="Language"
                                                 IsChecked="{Binding IsKorean, Mode=OneWay}"
                                                 Command="{Binding SetLanguageCommand}" CommandParameter="ko">
                                        <TextBlock Text="한국어" Style="{StaticResource ChipText}" />
                                    </RadioButton>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T 'After downloads finish'}" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{loc:T 'Action for this PC when every download is complete'}"
                                               Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <RadioButton Style="{StaticResource LanguageChip}" GroupName="AfterAction"
                                                 Margin="0,0,4,4"
                                                 IsChecked="{Binding IsAfterNone, Mode=OneWay}"
                                                 Command="{Binding SetAfterDownloadsCompleteCommand}" CommandParameter="none">
                                        <TextBlock Text="{loc:T 'Do nothing'}" Style="{StaticResource ChipText}" />
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource LanguageChip}" GroupName="AfterAction"
                                                 Margin="0,0,4,4"
                                                 IsChecked="{Binding IsAfterShutdown, Mode=OneWay}"
                                                 Command="{Binding SetAfterDownloadsCompleteCommand}" CommandParameter="shutdown">
                                        <TextBlock Text="{loc:T 'Shut down'}" Style="{StaticResource ChipText}" />
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource LanguageChip}" GroupName="AfterAction"
                                                 Margin="0,0,4,4"
                                                 IsChecked="{Binding IsAfterSleep, Mode=OneWay}"
                                                 Command="{Binding SetAfterDownloadsCompleteCommand}" CommandParameter="sleep">
                                        <TextBlock Text="{loc:T 'Sleep'}" Style="{StaticResource ChipText}" />
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource LanguageChip}" GroupName="AfterAction"
                                                 Margin="0,0,4,4"
                                                 IsChecked="{Binding IsAfterHibernate, Mode=OneWay}"
                                                 Command="{Binding SetAfterDownloadsCompleteCommand}" CommandParameter="hibernate">
                                        <TextBlock Text="{loc:T 'Hibernate'}" Style="{StaticResource ChipText}" />
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource LanguageChip}" GroupName="AfterAction"
                                                 IsChecked="{Binding IsAfterRestart, Mode=OneWay}"
                                                 Command="{Binding SetAfterDownloadsCompleteCommand}" CommandParameter="restart">
                                        <TextBlock Text="{loc:T 'Restart'}" Style="{StaticResource ChipText}" />
                                    </RadioButton>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'Run when you log into Windows'}" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{loc:T 'Start quietly with Windows'}"
                                               Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                              IsChecked="{Binding StartWithWindows}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'Minimize to tray'}" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{loc:T 'Closing the window keeps downloads running'}"
                                               Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                              IsChecked="{Binding CloseToTray}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'Start minimized'}" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{loc:T 'Show only the tray icon'}" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                              IsChecked="{Binding StartMinimized}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'Notifications'}" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{loc:T 'Notify on completion and errors'}"
                                               Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                              IsChecked="{Binding ShowNotifications}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}" BorderThickness="0" Padding="0,12,0,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'Restore session'}" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{loc:T 'Resume unfinished downloads on startup'}"
                                               Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                              IsChecked="{Binding AutoResume}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- network -->
                <Border Style="{StaticResource SettingsSection}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <Border Style="{StaticResource SectionIcon}" Background="{DynamicResource B_1622D3EE}" BorderBrush="{DynamicResource B_3022D3EE}">
                                <TextBlock Text="&#xE774;" Style="{StaticResource IconGlyph}" FontSize="15"
                                           Foreground="{DynamicResource B_A5F3FC}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:T 'Network'}" Style="{StaticResource H3}" />
                                <TextBlock Text="{loc:T 'Port, peer discovery and encryption'}"
                                           Style="{StaticResource SettingHint}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <Border Style="{StaticResource SettingRow}" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'Listening port'}" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{loc:T 'TCP/UDP. Change applies after restart'}"
                                               Style="{StaticResource SettingHint}" />
                                    <TextBlock Text="{loc:T 'The new port takes effect after restart'}"
                                               FontSize="9.5" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0"
                                               Visibility="{Binding PortRestartHintVisible, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding ListenPortText, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="DHT" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{loc:T 'Trackerless distributed hash table'}" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                              IsChecked="{Binding EnableDht}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="PEX" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{loc:T 'Peer exchange between clients'}" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                              IsChecked="{Binding EnablePex}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'Local discovery'}" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{loc:T 'Discover peers on the local network'}" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                              IsChecked="{Binding EnableLsd}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'Connection encryption'}" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{loc:T 'MSE/PE, compatible with open peers'}" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                              IsChecked="{Binding EnableEncryption}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="UPnP / NAT-PMP" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{loc:T 'Automatically open a port on the router'}" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                              IsChecked="{Binding EnableUpnp}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}" BorderThickness="0" Padding="0,12,0,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'Maximum connections'}" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{loc:T 'Total TCP connection limit'}" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <TextBox Style="{StaticResource NumberBox}" Text="{Binding MaxConnectionsText, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- updates -->
                <Border Style="{StaticResource SettingsSection}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <Border Style="{StaticResource SectionIcon}" Background="{DynamicResource B_1622D3EE}"
                                    BorderBrush="{DynamicResource B_3022D3EE}">
                                <TextBlock Text="&#xE895;" Style="{StaticResource IconGlyph}" FontSize="15"
                                           Foreground="{DynamicResource DownloadBrush}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:T 'Updates'}" Style="{StaticResource H3}" />
                                <TextBlock Text="{loc:T 'Check and install new versions'}"
                                           Style="{StaticResource SettingHint}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'Check for updates automatically'}" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{loc:T 'Uses the public GitHub Releases feed'}" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                              IsChecked="{Binding AutoCheckUpdates}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T 'Check interval'}" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{loc:T 'How often to look for a new release'}" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Style="{StaticResource NumberBox}" Width="80"
                                         IsEnabled="{Binding AutoCheckUpdates}"
                                         Text="{Binding UpdateIntervalText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="2" Text="{loc:T 'hours'}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}" BorderThickness="0" Padding="0,12,0,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'Install updates automatically'}" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{loc:T 'Downloads, installs and restarts ZTorrent. When off, updates are only checked.'}"
                                               Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                              IsChecked="{Binding AutoInstallUpdates}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- speed -->
                <Border Style="{StaticResource SettingsSection}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <Border Style="{StaticResource SectionIcon}" Background="{DynamicResource B_16F472B6}" BorderBrush="{DynamicResource B_30F472B6}">
                                <TextBlock Text="&#xE945;" Style="{StaticResource IconGlyph}" FontSize="15"
                                           Foreground="{DynamicResource B_FBCFE8}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:T 'Speed'}" Style="{StaticResource H3}" />
                                <TextBlock Text="{loc:T 'Traffic limits and upload slots'}"
                                           Style="{StaticResource SettingHint}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <Border Style="{StaticResource SettingRow}" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'Download limit'}" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{loc:T '0 — unlimited'}" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding MaxDownloadText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="2" Text="{loc:T 'KB/s'}" Style="{StaticResource MicroCaption}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'Upload limit'}" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{loc:T '0 — unlimited'}" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding MaxUploadText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="2" Text="{loc:T 'KB/s'}" Style="{StaticResource MicroCaption}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}" BorderThickness="0" Padding="0,12,0,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'Upload slots'}" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{loc:T 'How many peers receive data at once'}" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <TextBox Style="{StaticResource NumberBox}" Text="{Binding UploadSlotsText, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- storage / data -->
                <Border Style="{StaticResource SettingsSection}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <Border Style="{StaticResource SectionIcon}" Background="{DynamicResource B_1634D399}" BorderBrush="{DynamicResource B_3034D399}">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}" FontSize="15"
                                           Foreground="{DynamicResource B_A7F3D0}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:T 'Storage and data'}" Style="{StaticResource H3}" />
                                <TextBlock Text="{loc:T 'Cache, logs and local app files'}"
                                           Style="{StaticResource SettingHint}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <Border Style="{StaticResource SettingRow}" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'Disk cache'}" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{loc:T 'Piece write buffer, MB'}" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding DiskCacheText, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'App data'}" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{Binding DataDirectory}" Style="{StaticResource SettingHint}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="9"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="10,6"
                                        Command="{Binding OpenDataFolderCommand}">
                                    <TextBlock Text="{loc:T 'Open'}" FontSize="10.5" />
                                </Button>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}" BorderThickness="0" Padding="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'Logs'}" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{loc:T 'Local diagnostic logs, no telemetry'}"
                                               Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="10,6"
                                        Command="{Binding OpenLogsFolderCommand}">
                                    <TextBlock Text="{loc:T 'Open'}" FontSize="10.5" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="2,0,0,4">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding ResetCommand}">
                        <TextBlock Text="{loc:T 'Reset to defaults'}" />
                    </Button>
                    <TextBlock Text="ZTorrent 2.0.0 · MonoTorrent 3.0.2" Style="{StaticResource MicroCaption}"
                               VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{DynamicResource TextDisabledBrush}" />
                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0">
                        <Hyperlink NavigateUri="https://github.com/Cahard/ZTorrent"
                                   RequestNavigate="GitHubLink_OnRequestNavigate"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextDecorations="None" FontSize="10">
                            <InlineUIContainer BaselineAlignment="Center">
                                <Viewbox Width="11" Height="11" Margin="0,1,4,0">
                                    <Path Fill="{DynamicResource TextSecondaryBrush}"
                                          Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.729.083-.729 1.205.084 1.84 1.237 1.84 1.237 1.07 1.835 2.807 1.305 3.492.997.108-.775.418-1.305.762-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23a11.5 11.5 0 0 1 3-.405c1.02.005 2.045.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                                </Viewbox>
                            </InlineUIContainer>
                            <Run Text="GitHub" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource B_14FFFFFF}" BorderThickness="0,1,0,0" Padding="0,12,8,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding ErrorMessage}" FontSize="10" Foreground="{DynamicResource DangerBrush}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ErrorMessage}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />
                <TextBlock Text="{loc:T 'Changes save automatically'}"
                           Style="{StaticResource MicroCaption}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
