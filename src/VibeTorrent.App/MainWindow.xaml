<Window x:Class="VibeTorrent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:VibeTorrent.App.Views"
        xmlns:controls="clr-namespace:VibeTorrent.App.Controls"
        mc:Ignorable="d"
        x:Name="RootWindow"
        Title="VibeTorrent"
        Width="1460" Height="920" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="{DynamicResource B_070810}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource TextFont}" TextOptions.TextFormattingMode="Display"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        AllowDrop="True"
        PreviewDragEnter="Window_PreviewDragOver"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDragLeave="Window_PreviewDragLeave"
        PreviewDrop="Window_PreviewDrop" xmlns:loc="clr-namespace:VibeTorrent.App.Localization">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SidebarLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
            <Setter Property="Margin" Value="13,0,0,7" />
        </Style>

        <Style x:Key="NavCountBadge" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource B_10FFFFFF}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="MinWidth" Value="21" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="StatusDot" TargetType="{x:Type Ellipse}">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Fill" Value="{DynamicResource TextDisabledBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Stats.IsEngineRunning}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Storyboard x:Key="ToastIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="38" To="0" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="RootLayer" Background="{DynamicResource B_070810}">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="WindowTranslate" Y="0" />
        </Grid.RenderTransform>

        <!-- ambient aurora -->
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse x:Name="GlowCyan" Width="980" Height="980" Canvas.Left="-330" Canvas.Top="-470" Opacity="0.3">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{DynamicResource C_5022D3EE}" Offset="0" />
                        <GradientStop Color="{DynamicResource C_1422D3EE}" Offset="0.5" />
                        <GradientStop Color="{DynamicResource C_0022D3EE}" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Width="820" Height="820" Canvas.Right="-260" Canvas.Top="-280" Opacity="0.24">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{DynamicResource C_55A855F7}" Offset="0" />
                        <GradientStop Color="{DynamicResource C_12A855F7}" Offset="0.55" />
                        <GradientStop Color="{DynamicResource C_00A855F7}" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Width="760" Height="760" Canvas.Left="220" Canvas.Bottom="-460" Opacity="0.18">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{DynamicResource C_50F472B6}" Offset="0" />
                        <GradientStop Color="{DynamicResource C_10F472B6}" Offset="0.55" />
                        <GradientStop Color="{DynamicResource C_00F472B6}" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- vignette and dot texture -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.45,0.38" GradientOrigin="0.45,0.38" RadiusX="0.85" RadiusY="0.9">
                    <GradientStop Color="{DynamicResource C_00000000}" Offset="0.45" />
                    <GradientStop Color="{DynamicResource C_48000000}" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle IsHitTestVisible="False" Opacity="0.4">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,30,30" ViewportUnits="Absolute" Stretch="None">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="#0DFFFFFF">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="1,1" RadiusX="0.65" RadiusY="0.65" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Border BorderBrush="{DynamicResource B_22FFFFFF}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>

                <!-- ============================== sidebar ============================== -->
                <Border Grid.RowSpan="3" Background="{DynamicResource B_E60A0D18}" BorderBrush="{DynamicResource B_18FFFFFF}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="56" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="17,0,14,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                              Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="pack://application:,,,/Assets/App.png" Width="30" Height="30"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="VibeTorrent" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="15.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <Border Grid.Column="2" CornerRadius="5" Background="{DynamicResource B_14A855F7}" BorderBrush="{DynamicResource B_35A855F7}"
                                    BorderThickness="1" Padding="5,2" VerticalAlignment="Center">
                                <TextBlock Text="1.4" FontSize="7.5" Foreground="{DynamicResource B_E9D5FF}" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                            <StackPanel Margin="14,0,14,0">
                                <TextBlock Text="{loc:T 'LIBRARY'}" Style="{StaticResource SidebarLabel}" />

                                <ToggleButton x:Name="NavAll" Style="{StaticResource NavToggle}"
                                              IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                                              Command="{Binding SetFilterCommand}" CommandParameter="all">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE8FD;" Style="{StaticResource NavIconAll}" FontSize="14"
                                                   HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="1" Text="{loc:T 'All downloads'}" Margin="9,0,4,0"
                                                   VerticalAlignment="Center" FontSize="12.5"  Style="{StaticResource NavTextAll}" />
                                        <Border Grid.Column="2" Style="{StaticResource NavCountBadge}">
                                            <TextBlock Text="{Binding AllCount}" FontSize="9"
                                                       HorizontalAlignment="Center"  Style="{StaticResource NavTextAll}" />
                                        </Border>
                                    </Grid>
                                </ToggleButton>

                                <ToggleButton x:Name="NavActive" Style="{StaticResource NavToggle}"
                                              IsChecked="{Binding IsFilterActive, Mode=OneWay}"
                                              Command="{Binding SetFilterCommand}" CommandParameter="active">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE896;" Style="{StaticResource NavIconActive}" FontSize="14"
                                                   HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="1" Text="{loc:T 'Active'}" Margin="9,0,4,0"
                                                   VerticalAlignment="Center" FontSize="12.5"  Style="{StaticResource NavTextActive}" />
                                        <Border Grid.Column="2" Style="{StaticResource NavCountBadge}">
                                            <TextBlock Text="{Binding ActiveCount}" FontSize="9"
                                                       HorizontalAlignment="Center"  Style="{StaticResource NavTextActive}" />
                                        </Border>
                                    </Grid>
                                </ToggleButton>

                                <ToggleButton x:Name="NavCompleted" Style="{StaticResource NavToggle}"
                                              IsChecked="{Binding IsFilterCompleted, Mode=OneWay}"
                                              Command="{Binding SetFilterCommand}" CommandParameter="completed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource NavIconCompleted}" FontSize="13"
                                                   HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="1" Text="{loc:T 'Completed'}" Margin="9,0,4,0"
                                                   VerticalAlignment="Center" FontSize="12.5"  Style="{StaticResource NavTextCompleted}" />
                                        <Border Grid.Column="2" Style="{StaticResource NavCountBadge}">
                                            <TextBlock Text="{Binding CompletedCount}" FontSize="9"
                                                       HorizontalAlignment="Center"  Style="{StaticResource NavTextCompleted}" />
                                        </Border>
                                    </Grid>
                                </ToggleButton>

                                <ToggleButton x:Name="NavPaused" Style="{StaticResource NavToggle}"
                                              IsChecked="{Binding IsFilterPaused, Mode=OneWay}"
                                              Command="{Binding SetFilterCommand}" CommandParameter="paused">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE769;" Style="{StaticResource NavIconPaused}" FontSize="12"
                                                   HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="1" Text="{loc:T 'Paused'}" Margin="9,0,4,0"
                                                   VerticalAlignment="Center" FontSize="12.5"  Style="{StaticResource NavTextPaused}" />
                                        <Border Grid.Column="2" Style="{StaticResource NavCountBadge}">
                                            <TextBlock Text="{Binding PausedCount}" FontSize="9"
                                                       HorizontalAlignment="Center"  Style="{StaticResource NavTextPaused}" />
                                        </Border>
                                    </Grid>
                                </ToggleButton>

                                <ToggleButton x:Name="NavError" Style="{StaticResource NavToggle}"
                                              IsChecked="{Binding IsFilterError, Mode=OneWay}"
                                              Command="{Binding SetFilterCommand}" CommandParameter="error">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE7BA;" Style="{StaticResource NavIconError}" FontSize="13"
                                                   HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="1" Text="{loc:T 'Error'}" Margin="9,0,4,0"
                                                   VerticalAlignment="Center" FontSize="12.5"  Style="{StaticResource NavTextError}" />
                                        <Border Grid.Column="2" Style="{StaticResource NavCountBadge}">
                                            <TextBlock Text="{Binding ErrorCount}" FontSize="9"
                                                       HorizontalAlignment="Center"  Style="{StaticResource NavTextError}" />
                                        </Border>
                                    </Grid>
                                </ToggleButton>

                                <Border Height="1" Background="{DynamicResource DividerGradient}" Margin="12,15,12,14" />
                                <TextBlock Text="{loc:T 'TOOLS'}" Style="{StaticResource SidebarLabel}" />

                                <Button Style="{StaticResource GhostButton}" Height="42" Padding="12,0"
                                        HorizontalContentAlignment="Stretch" Command="{Binding OpenMagnetCommand}"
                                        Margin="0,0,0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE71B;" Style="{StaticResource IconGlyph}" FontSize="14"
                                                   HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="1" Text="{loc:T 'Add by link'}" FontSize="12.5"
                                                   Margin="9,0,4,0" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>



                                <ToggleButton x:Name="NavSettings" Style="{StaticResource NavToggle}"
                                              IsChecked="{Binding IsSettingsOpen, Mode=OneWay}"
                                              Command="{Binding OpenSettingsCommand}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE713;" Style="{StaticResource NavIconSettings}" FontSize="13"
                                                   HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="1" Text="{loc:T 'Settings'}" Margin="9,0,0,0"
                                                   VerticalAlignment="Center" FontSize="12.5"  Style="{StaticResource NavTextSettings}" />
                                    </Grid>
                                </ToggleButton>

                                <Border Height="1" Background="{DynamicResource DividerGradient}" Margin="12,14,12,14" />

                                <Border CornerRadius="12" Background="{DynamicResource B_0AFFFFFF}" BorderBrush="{DynamicResource B_16FFFFFF}"
                                        BorderThickness="1" Padding="11,9" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,7,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{loc:T 'Network'}" FontSize="10" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DhtStatusText}" FontSize="8.5"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding ListenPortText}" FontSize="8"
                                                   Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Margin="14,0,14,13">
                                <Button Style="{StaticResource GhostButton}" Height="42" Padding="12,0" Margin="0,0,0,8"
                                    HorizontalContentAlignment="Stretch"
                                    Command="{Binding CheckForUpdatesCommand}"
                                    IsEnabled="{Binding IsInitialized}"
                                    ToolTip="{Binding UpdateStatusText}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE895;" Style="{StaticResource IconGlyph}" FontSize="14"
                                               HorizontalAlignment="Left"
                                               Foreground="{DynamicResource DownloadBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding UpdateButtonText}" FontSize="12.5"
                                               Margin="9,0,4,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Button>
                            <Border CornerRadius="14" Background="{DynamicResource B_0D111F}" BorderBrush="{DynamicResource B_1BFFFFFF}" BorderThickness="1"
                                    Padding="12,11" Cursor="Hand"
                                    ToolTip="{loc:T 'Change download folder'}"
                                    MouseLeftButtonUp="StorageCard_OnMouseLeftButtonUp">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}" FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="{loc:T 'STORAGE'}" Style="{StaticResource MicroCaption}" FontSize="8.5" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding StorageFreeText}" FontSize="9"
                                                   HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Grid>
                                    <controls:LinearProgress Height="3" Margin="0,8,0,5"
                                                             Value="{Binding StorageUsedPercent, Mode=OneWay}"
                                                             TrackBrush="{DynamicResource B_20FFFFFF}"
                                                             ProgressBrush="{DynamicResource AccentGradientHorizontal}" />
                                    <Grid>
                                        <TextBlock Text="{Binding StoragePathText}" FontSize="8.3"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding StoragePathText}" />
                                        <TextBlock Text="{Binding StorageTotalText}" FontSize="8.3"
                                                   Foreground="{DynamicResource TextDisabledBrush}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================== title bar ============================== -->
                <Grid Grid.Row="0" Grid.Column="1" x:Name="TitleBar" Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
                        <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding EngineStatusText}" FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <Border Width="1" Height="12" Background="{DynamicResource B_1CFFFFFF}" Margin="11,0" />
                        <TextBlock Text="{Binding DhtStatusText}" FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <Border Width="1" Height="12" Background="{DynamicResource B_1CFFFFFF}" Margin="11,0" />
                        <TextBlock Text="{Binding ListenPortText}" FontSize="10"
                                   Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Border Background="{DynamicResource B_0CFFFFFF}" BorderBrush="{DynamicResource B_14FFFFFF}" BorderThickness="1" CornerRadius="8"
                                Padding="9,5" Margin="0,0,10,0">
                            <TextBlock FontSize="9.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="&#x2193;" Foreground="{DynamicResource DownloadBrush}" />
                                <Run Text="{Binding DownloadSpeedText, Mode=OneWay}" />
                                <Run Text="   " />
                                <Run Text="&#x2191;" Foreground="{DynamicResource UploadBrush}" />
                                <Run Text="{Binding UploadSpeedText, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                        <Button Style="{StaticResource WindowControlButton}" Click="MinimizeButton_OnClick"
                                ToolTip="{loc:T 'Collapse'}">
                            <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                        </Button>
                        <Button Style="{StaticResource WindowControlButton}" Click="MaximizeButton_OnClick"
                                ToolTip="{loc:T 'Expand'}">
                            <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                        </Button>
                        <Button Style="{StaticResource CloseWindowButton}" Click="CloseButton_OnClick"
                                ToolTip="{loc:T 'Close'}">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ============================== content ============================== -->
                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <views:LibraryView x:Name="Library" Grid.Column="0"
                                       Visibility="{Binding IsSettingsOpen, Converter={StaticResource InverseBoolToVisibility}}" />

                    <views:SettingsView Grid.Column="0" DataContext="{Binding SettingsPage}"
                                        Visibility="{Binding DataContext.IsSettingsOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

                    <views:TorrentDetailsView Grid.Column="1"
                                              Visibility="{Binding ShowDetailsPane, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <!-- ============================== status bar ============================== -->
                <Border Grid.Row="2" Grid.Column="1" BorderBrush="{DynamicResource B_12FFFFFF}" BorderThickness="0,1,0,0"
                        Background="{DynamicResource StatusBarBrush}">
                    <Grid Margin="22,0,18,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Style="{StaticResource StatusDot}" Width="5" Height="5" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding EngineStatusText}" FontSize="9"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="·" FontSize="9" Foreground="{DynamicResource TextDisabledBrush}" Margin="8,0" />
                            <TextBlock Text="{Binding DhtStatusText}" FontSize="9"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="·" FontSize="9" Foreground="{DynamicResource TextDisabledBrush}" Margin="8,0" />
                            <TextBlock Text="{Binding UptimeLabel}" FontSize="9"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="8"
                                       Foreground="{DynamicResource TextDisabledBrush}" Margin="0,0,4,0" />
                            <TextBlock Text="{loc:T 'Local data only'}" FontSize="8.5"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="·" FontSize="9" Foreground="{DynamicResource TextDisabledBrush}" Margin="8,0" />
                            <TextBlock Text="VibeTorrent 1.4.5" FontSize="8.5" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============================== add dialog ============================== -->
        <Grid x:Name="AddOverlay" Panel.ZIndex="100" Background="{DynamicResource B_C2070812}"
              FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAddDialogOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                                         Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <views:AddTorrentView DataContext="{Binding AddDialog}" HorizontalAlignment="Center"
                                  VerticalAlignment="Center" Margin="24" />
        </Grid>

        <!-- ============================== confirm dialog ============================== -->
        <Grid x:Name="ConfirmOverlay" Panel.ZIndex="110" Background="{DynamicResource B_B8070812}"
              FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConfirmRemoveOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                                         Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <views:ConfirmRemoveView DataContext="{Binding ConfirmRemove}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- ============================== toasts ============================== -->
        <ItemsControl ItemsSource="{Binding Toasts}" Panel.ZIndex="200"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,68,20,0" Width="336">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource B_F2141828}" BorderBrush="{DynamicResource B_36FFFFFF}" BorderThickness="1" CornerRadius="12"
                            Margin="0,0,0,8" ClipToBounds="True">
                        <Border.RenderTransform>
                            <TranslateTransform X="0" />
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard Storyboard="{StaticResource ToastIn}" />
                            </EventTrigger>
                        </Border.Triggers>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{Binding AccentBrush}" />
                            <Border Grid.Column="1" Width="28" Height="28" CornerRadius="9" Background="{DynamicResource B_0FFFFFFF}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{Binding AccentBrush}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="2" Margin="0,10,8,10" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Message}" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="24" Height="24"
                                    VerticalAlignment="Top" Margin="0,4,4,0"
                                    Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyph}" FontSize="8" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ============================== drag overlay ============================== -->
        <Grid Panel.ZIndex="300" Background="{DynamicResource B_D9080A12}"
              Visibility="{Binding IsDragOver, Converter={StaticResource BoolToVisibility}}"
              IsHitTestVisible="False">
            <Border Margin="20" CornerRadius="18" BorderBrush="{DynamicResource B_887C3AED}" BorderThickness="2">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                        <GradientStop Color="{DynamicResource C_207C3AED}" Offset="0" />
                        <GradientStop Color="{DynamicResource C_06080A12}" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="76" Height="76" CornerRadius="24" Background="{DynamicResource B_20FFFFFF}"
                            BorderBrush="{DynamicResource B_50FFFFFF}" BorderThickness="1" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="30"
                                   Foreground="{DynamicResource B_FFFFFF}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{loc:T 'Drop to add'}" Style="{StaticResource H1}" FontSize="24"
                               HorizontalAlignment="Center" Margin="0,18,0,0" />
                    <TextBlock Text="{loc:T '.torrent file or magnet link'}" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>


