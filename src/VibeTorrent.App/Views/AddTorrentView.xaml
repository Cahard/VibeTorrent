<UserControl x:Class="VibeTorrent.App.Views.AddTorrentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="740" d:DesignWidth="820" xmlns:loc="clr-namespace:VibeTorrent.App.Localization">
    <UserControl.Resources>
        <Style x:Key="SettingHint" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SegmentedTab" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Bg" CornerRadius="8" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1" Padding="14,7"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource B_0FFFFFFF}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedChipBrush}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource SelectedChipBorderBrush}" />
                                <Setter TargetName="Bg" Property="TextElement.Foreground" Value="{DynamicResource SelectedChipForeground}" />
                                <Setter Property="Foreground" Value="{DynamicResource SelectedChipForeground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Width="820" MaxHeight="790" CornerRadius="20" Background="{DynamicResource B_0D101B}"
            BorderBrush="{DynamicResource B_38FFFFFF}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="70" ShadowDepth="22" Direction="270" Color="{DynamicResource C_F0000000}"
                              Opacity="0.7" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Margin="24,20,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="13" Background="{DynamicResource AccentGradientSoft}"
                        BorderBrush="{DynamicResource B_40FFFFFF}" BorderThickness="1" Margin="0,0,13,0" VerticalAlignment="Top">
                    <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}" FontSize="18"
                               Foreground="{DynamicResource B_FFFFFF}" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="32" Height="32"
                        Command="{Binding CloseCommand}" ToolTip="{loc:T 'Close'}" VerticalAlignment="Top">
                    <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyph}" FontSize="10" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="24,16,24,4" Margin="0,0,0,0">
                <StackPanel>
                    <!-- mode switch -->
                    <Border HorizontalAlignment="Left" Background="{DynamicResource B_08FFFFFF}" BorderBrush="{DynamicResource B_16FFFFFF}"
                            BorderThickness="1" CornerRadius="10" Padding="3" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentedTab}" GroupName="AddMode"
                                         IsChecked="{Binding IsFileMode, Mode=OneWay}"
                                         Command="{Binding SwitchModeCommand}" CommandParameter="file">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:T '.torrent file'}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SegmentedTab}" GroupName="AddMode"
                                         IsChecked="{Binding IsMagnetMode, Mode=OneWay}"
                                         Command="{Binding SwitchModeCommand}" CommandParameter="magnet">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:T 'Magnet link'}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- file picker -->
                    <Border CornerRadius="13" BorderBrush="{DynamicResource B_30FFFFFF}" BorderThickness="1"
                            Background="{DynamicResource B_0AFFFFFF}" Padding="16,14"
                            Visibility="{Binding IsFileMode, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource B_1622D3EE}"
                                    BorderBrush="{DynamicResource B_3022D3EE}" BorderThickness="1" Margin="0,0,12,0">
                                <TextBlock Text="&#xE8E5;" Style="{StaticResource IconGlyph}" FontSize="18"
                                           Foreground="{DynamicResource CyanBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TorrentPathDisplay}"
                                           FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{loc:T 'The file is read locally and never uploaded'}"
                                           Style="{StaticResource SettingHint}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Padding="12,8"
                                    Command="{Binding BrowseCommand}" VerticalAlignment="Center">
                                <TextBlock Text="{loc:T 'Browse…'}" FontSize="11" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- magnet input -->
                    <StackPanel Visibility="{Binding IsMagnetMode, Converter={StaticResource BoolToVisibility}}">
                        <Border CornerRadius="13" BorderBrush="{DynamicResource B_30FFFFFF}" BorderThickness="1" Background="{DynamicResource B_0AFFFFFF}"
                                Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Style="{StaticResource DarkTextBox}" Height="64"
                                         Text="{Binding MagnetText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         Tag="magnet:?xt=urn:btih:…" Background="{DynamicResource B_08000000}" />
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <TextBlock Text="{loc:T 'BTIH and multi-hash magnets are supported.'}"
                                               Style="{StaticResource SettingHint}" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource SecondaryButton}" Padding="10,6"
                                            HorizontalAlignment="Right" Command="{Binding PasteMagnetCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE77F;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                       VerticalAlignment="Center" Margin="0,0,5,0" />
                                            <TextBlock Text="{loc:T 'Paste'}" FontSize="10.5" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- preview -->
                    <Border CornerRadius="13" BorderBrush="{DynamicResource B_26FFFFFF}" BorderThickness="1" Margin="0,12,0,0"
                            Background="{DynamicResource B_0C101C}" Padding="14"
                            Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource AccentGradient}"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding SourceName, Converter={StaticResource FirstLetter}}"
                                           Style="{StaticResource DisplayTitle}" FontSize="26" Foreground="{DynamicResource B_EFFFFFFF}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,10,0">
                                <TextBlock Text="{Binding SourceName}" FontSize="13.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SourceHash}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="9" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding TotalSizeText}" Style="{StaticResource MicroCaption}" />
                                    <TextBlock Text="·" Foreground="{DynamicResource TextDisabledBrush}" Margin="6,0" />
                                    <TextBlock Text="{Binding PreviewKindText}" Style="{StaticResource MicroCaption}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="2" CornerRadius="7" Background="{DynamicResource B_14FFFFFF}" Padding="8,5"
                                    VerticalAlignment="Top"
                                    Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding SelectedCountText}" FontSize="9.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- file list -->
                    <StackPanel Margin="0,12,0,0"
                                Visibility="{Binding ShowFiles, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="2,0,2,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:T 'CONTENTS'}" Style="{StaticResource MicroCaption}" />
                                <TextBlock Text="{Binding SelectedSizeText, StringFormat='· {0}'}"
                                           Style="{StaticResource MicroCaption}" Margin="5,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostButton}" Padding="8,3"
                                        Command="{Binding SelectAllCommand}">
                                    <TextBlock Text="{loc:T 'All'}" FontSize="9.5" />
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Padding="8,3"
                                        Command="{Binding ClearSelectionCommand}">
                                    <TextBlock Text="{loc:T 'None'}" FontSize="9.5" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border CornerRadius="12" BorderBrush="{DynamicResource B_18FFFFFF}" BorderThickness="1" Background="{DynamicResource B_08000000}"
                                Padding="4">
                            <ListBox ItemsSource="{Binding Files}" Height="170" Padding="0,2"
                                     ItemContainerStyle="{StaticResource DetailListItem}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Style="{StaticResource CompactCheckBox}" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="10.5"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       Margin="7,0,10,0" ToolTip="{Binding Path}" />
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="9"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>

                    <!-- destination -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:T 'DOWNLOAD FOLDER'}" Style="{StaticResource MicroCaption}" Margin="2,0,0,6" />
                            <TextBox Style="{StaticResource DarkTextBox}" Padding="11,9"
                                     Text="{Binding SavePath, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="12,9"
                                Command="{Binding BrowseFolderCommand}" Margin="8,19,0,0" VerticalAlignment="Top">
                            <TextBlock Text="{loc:T 'Choose'}" FontSize="11" />
                        </Button>
                    </Grid>

                    <Grid Margin="2,12,2,0">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartImmediately}"
                                          VerticalAlignment="Center" />
                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:T 'Start immediately'}" FontSize="11.5" FontWeight="SemiBold" />
                                <TextBlock Text="{loc:T 'Otherwise the torrent starts paused'}" Style="{StaticResource SettingHint}"
                                           Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource B_1AFB7185}" BorderBrush="{DynamicResource B_44FB7185}" BorderThickness="1" CornerRadius="9"
                            Padding="10,7" Margin="0,12,0,0"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Top"
                                       Margin="0,1,7,0" />
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="10.5" Foreground="{DynamicResource B_FFE4E8}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- footer -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource B_14FFFFFF}" BorderThickness="0,1,0,0" Padding="24,14"
                    Background="{DynamicResource B_0A0C16}" CornerRadius="0,0,20,20">
                <Grid>
                    <TextBlock Text="{loc:T 'The torrent will be added to the library and queued.'}"
                               Style="{StaticResource MicroCaption}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding CloseCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Margin="0,0,8,0">
                            <TextBlock Text="{loc:T 'Cancel'}" />
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                MinWidth="144">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           Foreground="{DynamicResource OnAccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="{loc:T 'Add torrent'}" Foreground="{DynamicResource OnAccentBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

