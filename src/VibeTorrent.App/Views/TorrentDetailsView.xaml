<UserControl x:Class="VibeTorrent.App.Views.TorrentDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:VibeTorrent.App.Controls"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="384"
             Width="384" xmlns:loc="clr-namespace:VibeTorrent.App.Localization">
    <UserControl.Resources>
        <Style x:Key="DetailStatCard" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource B_0BFFFFFF}" />
            <Setter Property="BorderBrush" Value="{DynamicResource B_12FFFFFF}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style x:Key="DetailStatLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MicroCaption}">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style x:Key="DetailStatValue" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource B_0B0D17}" BorderBrush="{DynamicResource B_18FFFFFF}" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- panel header -->
            <Grid Grid.Row="0" Margin="18,0,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T 'DETAILS'}" Style="{StaticResource MicroCaption}"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <Border Width="1" Height="11" Background="{DynamicResource B_22FFFFFF}" Margin="10,0" />
                    <TextBlock Text="{Binding Details.Summary.Status, Converter={StaticResource StatusText}}"
                               Style="{StaticResource MicroCaption}"
                               Foreground="{Binding Details.Summary.Status, Converter={StaticResource StatusBrush}}" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Width="30" Height="30"
                        HorizontalAlignment="Right" Command="{Binding ToggleDetailsPaneCommand}"
                        ToolTip="{loc:T 'Hide panel'}">
                    <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyph}" FontSize="10" />
                </Button>
            </Grid>

            <!-- cover -->
            <Border Grid.Row="1" Margin="18,0,18,0" Height="138" CornerRadius="16"
                    Background="{Binding Details.Summary.Status, Converter={StaticResource StatusGradient}}"
                    ClipToBounds="True"
                    Visibility="{Binding Details, Converter={StaticResource NullToVisibility}}">
                <Grid>
                    <Ellipse Width="220" Height="220" HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-110,-60,0" Fill="{DynamicResource B_1AFFFFFF}" />
                    <Ellipse Width="140" Height="140" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                             Margin="-70,0,0,-60" Fill="{DynamicResource B_12FFFFFF}" />
                    <TextBlock Text="{Binding Details.Summary.Name, Converter={StaticResource FirstLetter}}"
                               FontFamily="{StaticResource DisplayFont}" FontSize="128" FontWeight="Bold"
                               Foreground="{DynamicResource B_24FFFFFF}" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,14,0" />
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{DynamicResource B_66000000}" BorderBrush="{DynamicResource B_40FFFFFF}" BorderThickness="1"
                                    CornerRadius="7" Padding="7,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                               Foreground="{DynamicResource B_FFFFFF}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="TORRENT" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource B_EEFFFFFF}"
                                               FontFamily="{StaticResource MonoFont}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource B_66000000}" BorderBrush="{DynamicResource B_30FFFFFF}" BorderThickness="1"
                                    CornerRadius="7" Padding="7,3" Margin="5,0,0,0"
                                    Visibility="{Binding Details.Summary.IsPrivate, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:T 'PRIVATE'}" FontSize="8" FontFamily="{StaticResource MonoFont}"
                                           Foreground="{DynamicResource B_F5F3FF}" />
                            </Border>
                        </StackPanel>
                        <Grid Grid.Row="2">
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding Details.Summary.Name}" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="16.5" FontWeight="SemiBold" Foreground="{DynamicResource B_FFFFFF}"
                                           TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Details.Summary.InfoHash}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="8.5" Foreground="{DynamicResource OnAccentBrush}" Opacity="0.72" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- summary and actions -->
            <StackPanel Grid.Row="2" Margin="18,13,18,0"
                        Visibility="{Binding Details, Converter={StaticResource NullToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Margin="0,0,6,0"
                                 Fill="{Binding Details.Summary.Status, Converter={StaticResource StatusBrush}}" />
                        <TextBlock Text="{Binding Details.Summary.Status, Converter={StaticResource StatusText}}"
                                   FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{Binding Details.Summary.Status, Converter={StaticResource StatusBrush}}" />
                        <TextBlock Text="{Binding Details.Summary.EtaSeconds, Converter={StaticResource Eta}, StringFormat='· {0}'}"
                                   FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="5,0,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Details.Summary.Progress, Converter={StaticResource Percent}}"
                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Grid>
                <Grid Margin="0,7,0,0">
                    <controls:LinearProgress Height="5" Value="{Binding Details.Summary.Progress, Mode=OneWay}"
                                             TrackBrush="{DynamicResource B_20FFFFFF}"
                                             ProgressBrush="{Binding Details.Summary.Status, Converter={StaticResource StatusBrush}}" />
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Button Style="{StaticResource PrimaryButton}" Padding="12,8" Height="34"
                                Command="{Binding TogglePauseSelectedCommand}"
                                Visibility="{Binding Details.ShowPauseButton, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE769;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                           Foreground="{DynamicResource OnAccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:T 'Pause'}" FontSize="11.5" Foreground="{DynamicResource OnAccentBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Padding="12,8" Height="34"
                                Command="{Binding TogglePauseSelectedCommand}"
                                Visibility="{Binding Details.ShowResumeButton, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                           Foreground="{DynamicResource OnAccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:T 'Resume'}" FontSize="11.5" Foreground="{DynamicResource OnAccentBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Padding="12,8" Height="34"
                                IsEnabled="False"
                                Visibility="{Binding Details.IsQueued, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:T 'Queued'}" FontSize="11.5" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Width="34" Height="34"
                            Padding="0" Margin="6,0,0,0" Command="{Binding OpenDetailsFolderCommand}"
                            ToolTip="{loc:T 'Open folder'}">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}" FontSize="12" />
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Width="34" Height="34"
                            Padding="0" Margin="6,0,0,0"
                            Command="{Binding MoveDownloadFolderCommand}"
                            ToolTip="{loc:T 'Move download folder'}">
                        <TextBlock Text="&#xE8DE;" Style="{StaticResource IconGlyph}" FontSize="12" />
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Width="34" Height="34"
                            Padding="0" Margin="6,0,0,0"
                            Command="{Binding RequestRemoveCommand}" CommandParameter="{Binding SelectedTorrent}"
                            ToolTip="{loc:T 'Delete torrent'}">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource IconGlyph}" FontSize="12"
                                   Foreground="{DynamicResource DangerBrush}" />
                    </Button>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,9,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T 'Priority'}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <RadioButton Style="{StaticResource LanguageChip}" GroupName="TorrentPriority"
                                 Padding="10,4" Margin="0,0,4,0"
                                 IsChecked="{Binding Details.IsHighPriority, Mode=OneWay}"
                                 Command="{Binding SetTorrentPriorityCommand}" CommandParameter="High">
                        <TextBlock Text="{loc:T 'High'}" Style="{StaticResource ChipText}" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource LanguageChip}" GroupName="TorrentPriority"
                                 Padding="10,4" Margin="0,0,4,0"
                                 IsChecked="{Binding Details.IsNormalPriority, Mode=OneWay}"
                                 Command="{Binding SetTorrentPriorityCommand}" CommandParameter="Normal">
                        <TextBlock Text="{loc:T 'Normal'}" Style="{StaticResource ChipText}" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource LanguageChip}" GroupName="TorrentPriority"
                                 Padding="10,4"
                                 IsChecked="{Binding Details.IsLowPriority, Mode=OneWay}"
                                 Command="{Binding SetTorrentPriorityCommand}" CommandParameter="Low">
                        <TextBlock Text="{loc:T 'Low'}" Style="{StaticResource ChipText}" />
                    </RadioButton>
                </StackPanel>
            </StackPanel>

            <!-- tabs -->
            <TabControl Grid.Row="4" Margin="12,10,12,10" Style="{StaticResource DetailsTabControl}"
                        SelectedIndex="{Binding Details.SelectedTabIndex, Mode=TwoWay}"
                        Visibility="{Binding Details, Converter={StaticResource NullToVisibility}}">
                <TabItem x:Name="TabOverview" Style="{StaticResource DetailsTabItem}">
                    <TabItem.Header>
                        <TextBlock Text="{loc:T 'Overview'}" Style="{StaticResource TabText0}"
                                   Tag="{Binding IsSelected, ElementName=TabOverview}" />
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,4,0">
                        <StackPanel Margin="6,4,2,8">
                            <TextBlock Text="{loc:T 'TRANSFER'}" Style="{StaticResource MicroCaption}" Margin="2,0,0,7" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource DetailStatCard}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T 'SIZE'}" Style="{StaticResource DetailStatLabel}" />
                                        <TextBlock Text="{Binding Details.Summary.TotalSize, Converter={StaticResource Bytes}}"
                                                   Style="{StaticResource DetailStatValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource DetailStatCard}" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T 'DOWNLOADED'}" Style="{StaticResource DetailStatLabel}" />
                                        <TextBlock Text="{Binding Details.Summary.DownloadedBytes, Converter={StaticResource Bytes}}"
                                                   Style="{StaticResource DetailStatValue}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource DetailStatCard}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T 'UPLOADED'}" Style="{StaticResource DetailStatLabel}" />
                                        <TextBlock Text="{Binding Details.Summary.UploadedBytes, Converter={StaticResource Bytes}}"
                                                   Style="{StaticResource DetailStatValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource DetailStatCard}" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T 'RATIO'}" Style="{StaticResource DetailStatLabel}" />
                                        <TextBlock Text="{Binding Details.Summary.Ratio, Converter={StaticResource Ratio}}"
                                                   Style="{StaticResource DetailStatValue}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource DetailStatCard}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T 'PEERS'}" Style="{StaticResource DetailStatLabel}" />
                                        <TextBlock Text="{Binding Details.Summary.PeerCount}" Style="{StaticResource DetailStatValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource DetailStatCard}" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T 'SEEDS'}" Style="{StaticResource DetailStatLabel}" />
                                        <TextBlock Text="{Binding Details.Summary.SeedCount}" Style="{StaticResource DetailStatValue}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource DetailStatCard}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T 'FILES'}" Style="{StaticResource DetailStatLabel}" />
                                        <TextBlock Text="{Binding Details.Summary.FileCount}" Style="{StaticResource DetailStatValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource DetailStatCard}" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T 'ADDED'}" Style="{StaticResource DetailStatLabel}" />
                                        <TextBlock Text="{Binding Details.Summary.AddedAt, Converter={StaticResource DateTime}, ConverterParameter=short}"
                                                   Style="{StaticResource DetailStatValue}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="{loc:T 'TORRENT TRAFFIC'}" Style="{StaticResource MicroCaption}" Margin="2,9,0,6" />
                            <Border CornerRadius="10" Background="{DynamicResource B_0BFFFFFF}" BorderBrush="{DynamicResource B_12FFFFFF}"
                                    BorderThickness="1" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:T 'Download'}" FontSize="9"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,2" />
                                        <controls:Sparkline Values="{Binding SelectedTorrent.DownloadHistory}"
                                                            Stroke="{DynamicResource DownloadBrush}" Fill="{DynamicResource DownloadAreaBrush}" Height="42"
                                                            StrokeThickness="1.5">
                                        </controls:Sparkline>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{loc:T 'Upload'}" FontSize="9"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,2" />
                                        <controls:Sparkline Values="{Binding SelectedTorrent.UploadHistory}"
                                                            Stroke="{DynamicResource UploadBrush}" Fill="{DynamicResource UploadAreaBrush}" Height="42"
                                                            StrokeThickness="1.5">
                                        </controls:Sparkline>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="{loc:T 'SPEED LIMITS'}" Style="{StaticResource MicroCaption}" Margin="2,9,0,6" />
                            <Border CornerRadius="10" Background="{DynamicResource B_0BFFFFFF}" BorderBrush="{DynamicResource B_12FFFFFF}"
                                    BorderThickness="1" Padding="10,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:T 'Download limit'}" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}" Width="70"
                                                 Padding="7,4" TextAlignment="Right"
                                                 Text="{Binding SelectedDownloadLimitText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="2" Text="{loc:T 'KB/s'}" FontSize="9"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="6,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:T 'Upload limit'}" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}" Width="70"
                                                 Padding="7,4" TextAlignment="Right"
                                                 Text="{Binding SelectedUploadLimitText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="2" Text="{loc:T 'KB/s'}" FontSize="9"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="6,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0">
                                        <TextBlock Text="{loc:T '0 = unlimited'}" FontSize="9"
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <Button Style="{StaticResource SecondaryButton}" Padding="9,4"
                                                Command="{Binding ApplyTorrentLimitsCommand}">
                                            <TextBlock Text="{loc:T 'Apply'}" FontSize="10" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{loc:T 'LOCATION'}" Style="{StaticResource MicroCaption}" Margin="2,9,0,6" />
                            <Border CornerRadius="10" Background="{DynamicResource B_0BFFFFFF}" BorderBrush="{DynamicResource B_12FFFFFF}"
                                    BorderThickness="1" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Details.Summary.SavePath}" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Details.Summary.SavePath}" />
                                        <TextBlock Text="{Binding Details.SelectedSizeLabel}"
                                                   FontSize="9" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="27" Height="27"
                                            Command="{Binding CopySavePathCommand}" ToolTip="{loc:T 'Copy path'}">
                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource IconGlyph}" FontSize="10" />
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource B_0A7C3AED}" BorderBrush="{DynamicResource B_227C3AED}" BorderThickness="1"
                                    CornerRadius="10" Padding="10,8" Margin="0,8,0,0"
                                    Visibility="{Binding Details.Comment, Converter={StaticResource StringToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'COMMENT'}" Style="{StaticResource MicroCaption}" />
                                    <TextBlock Text="{Binding Details.Comment}" FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="2,9,0,0">
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'INFO HASH'}" Style="{StaticResource MicroCaption}" />
                                    <TextBlock Text="{Binding Details.Summary.InfoHash}" FontFamily="{StaticResource MonoFont}"
                                               FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Style="{StaticResource IconButton}" Width="27" Height="27"
                                        HorizontalAlignment="Right" Command="{Binding CopyInfoHashCommand}"
                                        CommandParameter="{Binding SelectedTorrent}" ToolTip="{loc:T 'Copy info hash'}">
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource IconGlyph}" FontSize="10" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="TabFiles" Style="{StaticResource DetailsTabItem}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:T 'Files'}" Style="{StaticResource TabText1}"
                                       Tag="{Binding IsSelected, ElementName=TabFiles}" />
                            <TextBlock Text="{Binding Details.FileCount}" Margin="4,0,0,0" Opacity="0.55"
                                       Style="{StaticResource TabText1}"
                                       Tag="{Binding IsSelected, ElementName=TabFiles}" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="4,4,4,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="5,0,3,6">
                            <TextBlock Text="{Binding Details.SelectedFilesLabel}"
                                       Style="{StaticResource MicroCaption}" />
                            <TextBlock Text="{Binding Details.SelectedFilesSizeText}" Style="{StaticResource MicroCaption}"
                                       HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Details.Files}"
                                 ItemContainerStyle="{StaticResource DetailListItem}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding RelativePath}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Style="{StaticResource CompactCheckBox}" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                  Command="{Binding DataContext.ToggleFileSelectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                        <Grid Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center">
                                            <Border CornerRadius="7" Background="{Binding RelativePath, Converter={StaticResource FileAccent}}"
                                                    Opacity="0.18" />
                                            <TextBlock Text="{Binding RelativePath, Converter={StaticResource FileIcon}}"
                                                       Style="{StaticResource IconGlyph}" FontSize="10"
                                                       Foreground="{Binding RelativePath, Converter={StaticResource FileAccent}}" />
                                        </Grid>
                                        <StackPanel Grid.Column="2" Margin="8,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RelativePath}" FontSize="10.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Grid Margin="0,4,0,0">
                                                <controls:LinearProgress Height="2.5" Value="{Binding Progress, Mode=OneWay}"
                                                                         TrackBrush="{DynamicResource B_16FFFFFF}"
                                                                         ProgressBrush="{DynamicResource AccentGradientHorizontal}" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Length, Converter={StaticResource Bytes}}" FontSize="9"
                                                       Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding Priority, Converter={StaticResource PriorityText}}"
                                                       FontSize="8" Foreground="{DynamicResource TextDisabledBrush}"
                                                       HorizontalAlignment="Right" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>

                <TabItem x:Name="TabTrackers" Style="{StaticResource DetailsTabItem}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:T 'Trackers'}" Style="{StaticResource TabText2}"
                                       Tag="{Binding IsSelected, ElementName=TabTrackers}" />
                            <TextBlock Text="{Binding Details.TrackerCount}" Margin="4,0,0,0" Opacity="0.55"
                                       Style="{StaticResource TabText2}"
                                       Tag="{Binding IsSelected, ElementName=TabTrackers}" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer Padding="4,4,4,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Details.Trackers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource B_0AFFFFFF}" BorderBrush="{DynamicResource B_10FFFFFF}" BorderThickness="1"
                                            CornerRadius="9" Padding="10,8" Margin="2,0,2,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Top" Margin="1,5,0,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="{x:Type Ellipse}">
                                                        <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="offline">
                                                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Url}" FontSize="9.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="8.5"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding Message}" FontSize="8.5"
                                                               Foreground="{DynamicResource DangerBrush}"
                                                               Margin="5,0,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="TabPeers" Style="{StaticResource DetailsTabItem}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:T 'Peers'}" Style="{StaticResource TabText3}"
                                       Tag="{Binding IsSelected, ElementName=TabPeers}" />
                            <TextBlock Text="{Binding Details.PeerCount}" Margin="4,0,0,0" Opacity="0.55"
                                       Style="{StaticResource TabText3}"
                                       Tag="{Binding IsSelected, ElementName=TabPeers}" />
                        </StackPanel>
                    </TabItem.Header>
                    <ListBox ItemsSource="{Binding Details.Peers}" ItemContainerStyle="{StaticResource DetailListItem}"
                             Padding="2,4,2,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Address}" FontFamily="{StaticResource MonoFont}"
                                                       FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <Border Background="{DynamicResource B_18A855F7}" CornerRadius="4" Padding="4,1" Margin="6,0,0,0"
                                                    Visibility="{Binding IsSeeder, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="S" FontSize="7.5" Foreground="{DynamicResource B_E9D5FF}" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Client}" FontSize="8.5"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding DownloadSpeed, Converter={StaticResource Speed}, StringFormat='↓ {0}'}"
                                                   FontSize="9" Foreground="{DynamicResource DownloadBrush}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding Progress, Converter={StaticResource Percent}}"
                                                   FontSize="8.5" Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Right" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
            </TabControl>

            <!-- no selection -->
            <Grid Grid.Row="1" Grid.RowSpan="4" Visibility="{Binding Details, Converter={StaticResource NullToVisibility}, ConverterParameter=inverse}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="260" Margin="20">
                    <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource B_0DFFFFFF}"
                            BorderBrush="{DynamicResource B_18FFFFFF}" BorderThickness="1" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE946;" Style="{StaticResource IconGlyph}" FontSize="23"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </Border>
                    <TextBlock Text="{loc:T 'Select a torrent'}" Style="{StaticResource H3}" HorizontalAlignment="Center"
                               Margin="0,14,0,0" />
                    <TextBlock Text="{loc:T 'Files, trackers, peers and detailed stats will appear here'}"
                               Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>

