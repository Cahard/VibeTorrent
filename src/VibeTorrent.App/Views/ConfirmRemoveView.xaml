<UserControl x:Class="VibeTorrent.App.Views.ConfirmRemoveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="470" xmlns:loc="clr-namespace:VibeTorrent.App.Localization">
    <Border Width="470" CornerRadius="18" Background="#0E111D" BorderBrush="#38FFFFFF" BorderThickness="1"
            Padding="22" TextOptions.TextFormattingMode="Display">
        <Border.Effect>
            <DropShadowEffect BlurRadius="60" ShadowDepth="18" Direction="270" Color="#E0000000" Opacity="0.65" />
        </Border.Effect>
        <StackPanel>
            <Grid>
                <Border Width="44" Height="44" CornerRadius="13" Background="#22FB7185"
                        BorderBrush="#55FB7185" BorderThickness="1" HorizontalAlignment="Left">
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Foreground="#FDA4AF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Button Style="{StaticResource IconButton}" Width="30" Height="30" HorizontalAlignment="Right"
                        Command="{Binding DataContext.CancelRemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="{loc:T 'Close'}">
                    <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyph}" FontSize="10" />
                </Button>
            </Grid>
            <TextBlock Text="{loc:T 'Delete torrent?'}" Style="{StaticResource H2}" Margin="0,15,0,0" />
            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis" MaxHeight="42" Margin="0,5,0,0" />
            <TextBlock Text="{Binding FileCountText}" Style="{StaticResource MicroCaption}" Margin="0,5,0,0" />

            <Border Background="#0BFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="11"
                    Padding="12,10" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:T 'Data size'}" Style="{StaticResource MicroCaption}" />
                        <TextBlock Text="{Binding SizeText}" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T 'The torrent will be removed from the list'}" FontSize="9.5"
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <CheckBox Style="{StaticResource DarkCheckBox}" Margin="2,15,0,0"
                      IsChecked="{Binding DeleteData}">
                <StackPanel>
                    <TextBlock Text="{loc:T 'Delete downloaded files'}" FontSize="11.5" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:T 'Files will be deleted from disk permanently.'}"
                               Style="{StaticResource MicroCaption}" Margin="0,2,0,0" />
                </StackPanel>
            </CheckBox>

            <Border Background="#16FB7185" CornerRadius="9" Padding="10,8" Margin="0,14,0,0"
                    BorderBrush="#33FB7185" BorderThickness="1"
                    Visibility="{Binding DeleteData, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               Foreground="{StaticResource DangerBrush}" VerticalAlignment="Top"
                               Margin="0,1,7,0" />
                    <TextBlock Text="{loc:T 'The download will stop and its files will be deleted.'}" FontSize="10"
                               Foreground="#FFE4E8" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Padding="14,9"
                        HorizontalAlignment="Right" Margin="0,0,8,0"
                        Command="{Binding DataContext.CancelRemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Content="{loc:T 'Cancel'}" />
                <Button Grid.Column="1" Style="{StaticResource DangerButton}" Padding="14,9" MinWidth="128"
                        Command="{Binding DataContext.ConfirmRemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="{loc:T 'Delete'}" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
