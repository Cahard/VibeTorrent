<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Surfaces -->
    <Color x:Key="ColorBase">#070810</Color>
    <Color x:Key="ColorBaseSoft">#0A0C17</Color>
    <Color x:Key="ColorSurface">#101321</Color>
    <Color x:Key="ColorSurfaceRaised">#15192B</Color>
    <Color x:Key="ColorSurfaceHover">#1B2036</Color>
    <Color x:Key="ColorLine">#22FFFFFF</Color>
    <Color x:Key="ColorLineStrong">#38FFFFFF</Color>

    <!-- Text -->
    <Color x:Key="ColorText">#F5F7FF</Color>
    <Color x:Key="ColorTextSecondary">#A6AEC7</Color>
    <Color x:Key="ColorTextMuted">#6D7693</Color>
    <Color x:Key="ColorTextDisabled">#4A526D</Color>

    <!-- Accents -->
    <Color x:Key="ColorCyan">#34D399</Color>
    <Color x:Key="ColorBlue">#10B981</Color>
    <Color x:Key="ColorViolet">#22C55E</Color>
    <Color x:Key="ColorPink">#4ADE80</Color>
    <Color x:Key="ColorSuccess">#34D399</Color>
    <Color x:Key="ColorWarning">#FBBF24</Color>
    <Color x:Key="ColorDanger">#FB7185</Color>
    <Color x:Key="ColorInfo">#2DD4BF</Color>

    <SolidColorBrush x:Key="BaseBrush" Color="{StaticResource ColorBase}" />
    <SolidColorBrush x:Key="BaseSoftBrush" Color="{StaticResource ColorBaseSoft}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource ColorSurfaceRaised}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource ColorSurfaceHover}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource ColorLine}" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource ColorLineStrong}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource ColorTextDisabled}" />
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource ColorCyan}" />
    <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource ColorViolet}" />
    <SolidColorBrush x:Key="PinkBrush" Color="{StaticResource ColorPink}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource ColorInfo}" />
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#34D399" Offset="0" />
        <GradientStop Color="#10B981" Offset="0.42" />
        <GradientStop Color="#22C55E" Offset="0.72" />
        <GradientStop Color="#4ADE80" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientHorizontal" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#34D399" Offset="0" />
        <GradientStop Color="#22C55E" Offset="0.55" />
        <GradientStop Color="#4ADE80" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientSoft" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3322D3EE" Offset="0" />
        <GradientStop Color="#336366F1" Offset="0.55" />
        <GradientStop Color="#33F472B6" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2DD4BF" Offset="0" />
        <GradientStop Color="#34D399" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F43F5E" Offset="0" />
        <GradientStop Color="#FB7185" Offset="0.6" />
        <GradientStop Color="#FDA4AF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10231D" Offset="0" />
        <GradientStop Color="#0B1714" Offset="0.6" />
        <GradientStop Color="#091310" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#07110E" Offset="0" />
        <GradientStop Color="#080F0D" Offset="0.5" />
        <GradientStop Color="#0A1411" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SearchGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#161A2C" Offset="0" />
        <GradientStop Color="#111422" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DividerGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#20FFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontDisplay">30</sys:Double>
    <sys:Double x:Key="FontH1">24</sys:Double>
    <sys:Double x:Key="FontH2">18</sys:Double>
    <sys:Double x:Key="FontH3">15</sys:Double>
    <sys:Double x:Key="FontBody">13.5</sys:Double>
    <sys:Double x:Key="FontSmall">12</sys:Double>
    <sys:Double x:Key="FontMicro">10.5</sys:Double>

    <CornerRadius x:Key="RadiusWindow">16</CornerRadius>
    <CornerRadius x:Key="RadiusCard">16</CornerRadius>
    <CornerRadius x:Key="RadiusButton">11</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="28" ShadowDepth="7" Direction="270"
                      Color="#C0000000" Opacity="0.35" />
    <DropShadowEffect x:Key="ModalShadow" BlurRadius="60" ShadowDepth="18" Direction="270"
                      Color="#E0000000" Opacity="0.6" />

    <LinearGradientBrush x:Key="CoverGradient1" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#065F46" Offset="0" />
        <GradientStop Color="#047857" Offset="0.55" />
        <GradientStop Color="#166534" Offset="1" />
    </LinearGradientBrush>


    <!-- Semantic traffic and primary-action colours: the same keys in every theme. -->
    <SolidColorBrush x:Key="DownloadBrush" Color="#34D399" />
    <SolidColorBrush x:Key="UploadBrush" Color="#FB7185" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="StatusBarBrush" Color="#66101612" />
    <SolidColorBrush x:Key="SelectedChipBrush" Color="#3348ED8A" />
    <SolidColorBrush x:Key="SelectedChipBorderBrush" Color="#68F6A1" />
    <SolidColorBrush x:Key="SelectedChipForeground" Color="#ECFDF5" />
    <LinearGradientBrush x:Key="DownloadAreaBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#5534D399" Offset="0" />
        <GradientStop Color="#0034D399" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="UploadAreaBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#55FB7185" Offset="0" />
        <GradientStop Color="#00FB7185" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryButtonGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#047857" Offset="0" /><GradientStop Color="#059669" Offset="0.52" /><GradientStop Color="#065F46" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
