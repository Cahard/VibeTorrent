<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Surfaces -->
    <Color x:Key="ColorBase">#F4F7FB</Color>
    <Color x:Key="ColorBaseSoft">#EEF2F8</Color>
    <Color x:Key="ColorSurface">#FFFFFF</Color>
    <Color x:Key="ColorSurfaceRaised">#F8FAFC</Color>
    <Color x:Key="ColorSurfaceHover">#E8EEF6</Color>
    <Color x:Key="ColorLine">#22000000</Color>
    <Color x:Key="ColorLineStrong">#38000000</Color>

    <!-- Text -->
    <Color x:Key="ColorText">#111827</Color>
    <Color x:Key="ColorTextSecondary">#475569</Color>
    <Color x:Key="ColorTextMuted">#64748B</Color>
    <Color x:Key="ColorTextDisabled">#94A3B8</Color>

    <!-- Accents -->
    <Color x:Key="ColorCyan">#0891B2</Color>
    <Color x:Key="ColorBlue">#059669</Color>
    <Color x:Key="ColorViolet">#16A34A</Color>
    <Color x:Key="ColorPink">#65A30D</Color>
    <Color x:Key="ColorSuccess">#059669</Color>
    <Color x:Key="ColorWarning">#FBBF24</Color>
    <Color x:Key="ColorDanger">#FB7185</Color>
    <Color x:Key="ColorInfo">#38BDF8</Color>

    <SolidColorBrush x:Key="BaseBrush" Color="{StaticResource ColorBase}" />
    <SolidColorBrush x:Key="BaseSoftBrush" Color="{StaticResource ColorBaseSoft}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource ColorSurfaceRaised}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource ColorSurfaceHover}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource ColorLine}" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource ColorLineStrong}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource ColorTextDisabled}" />
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource ColorCyan}" />
    <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource ColorViolet}" />
    <SolidColorBrush x:Key="PinkBrush" Color="{StaticResource ColorPink}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource ColorInfo}" />
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0891B2" Offset="0" />
        <GradientStop Color="#059669" Offset="0.42" />
        <GradientStop Color="#16A34A" Offset="0.72" />
        <GradientStop Color="#65A30D" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientHorizontal" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0891B2" Offset="0" />
        <GradientStop Color="#16A34A" Offset="0.55" />
        <GradientStop Color="#65A30D" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientSoft" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3322D3EE" Offset="0" />
        <GradientStop Color="#336366F1" Offset="0.55" />
        <GradientStop Color="#33F472B6" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0D9488" Offset="0" />
        <GradientStop Color="#059669" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F43F5E" Offset="0" />
        <GradientStop Color="#FB7185" Offset="0.6" />
        <GradientStop Color="#FDA4AF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F8FAFC" Offset="0.6" />
        <GradientStop Color="#F1F5F9" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F4F7FB" Offset="0" />
        <GradientStop Color="#EEF2F8" Offset="0.5" />
        <GradientStop Color="#F8FAFC" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SearchGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F1F5F9" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DividerGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#20000000" Offset="0.5" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontDisplay">30</sys:Double>
    <sys:Double x:Key="FontH1">24</sys:Double>
    <sys:Double x:Key="FontH2">18</sys:Double>
    <sys:Double x:Key="FontH3">15</sys:Double>
    <sys:Double x:Key="FontBody">13.5</sys:Double>
    <sys:Double x:Key="FontSmall">12</sys:Double>
    <sys:Double x:Key="FontMicro">10.5</sys:Double>

    <CornerRadius x:Key="RadiusWindow">16</CornerRadius>
    <CornerRadius x:Key="RadiusCard">16</CornerRadius>
    <CornerRadius x:Key="RadiusButton">11</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="28" ShadowDepth="7" Direction="270"
                      Color="#40000000" Opacity="0.35" />
    <DropShadowEffect x:Key="ModalShadow" BlurRadius="60" ShadowDepth="18" Direction="270"
                      Color="#60000000" Opacity="0.6" />

    <LinearGradientBrush x:Key="CoverGradient1" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0F766E" Offset="0" />
        <GradientStop Color="#047857" Offset="0.55" />
        <GradientStop Color="#166534" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
