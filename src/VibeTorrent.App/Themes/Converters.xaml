<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:VibeTorrent.App.Converters">

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <conv:InverseBooleanConverter x:Key="InverseBool" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    <conv:EmptyStringToVisibilityConverter x:Key="StringToVisibility" />
    <conv:ZeroToVisibilityConverter x:Key="ZeroToVisibility" />
    <conv:BytesConverter x:Key="Bytes" />
    <conv:SpeedConverter x:Key="Speed" />
    <conv:EtaConverter x:Key="Eta" />
    <conv:PercentConverter x:Key="Percent" />
    <conv:RatioConverter x:Key="Ratio" />
    <conv:CountConverter x:Key="Count" />
    <conv:StatusBrushConverter x:Key="StatusBrush" />
    <conv:StatusTextConverter x:Key="StatusText" />
    <conv:StatusGlyphConverter x:Key="StatusGlyph" />
    <conv:StatusGradientConverter x:Key="StatusGradient" />
    <conv:FileIconConverter x:Key="FileIcon" />
    <conv:FileAccentConverter x:Key="FileAccent" />
    <conv:FirstLetterConverter x:Key="FirstLetter" />
    <conv:DateTimeConverter x:Key="DateTime" />
    <conv:FilePriorityTextConverter x:Key="PriorityText" />

</ResourceDictionary>
